<?xml version="1.0" encoding="utf-8" ?>
<!-- Подбор профессии = Match.vue: слева рассказ о себе, справа три направления с вакансиями. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppNative.ViewModels"
             xmlns:controls="clr-namespace:AppNative.Views.Controls"
             x:Class="AppNative.Views.MatchPage"
             x:DataType="vm:MatchViewModel"
             Title="Подбор"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <controls:AppTopBar Grid.Row="0" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout>
                <Grid Padding="{OnIdiom Phone='16,40,16,96', Desktop='32,64,32,128'}">
                    <Grid MaximumWidthRequest="1320" HorizontalOptions="Fill"
                          ColumnDefinitions="{OnIdiom Phone='*', Desktop='5*,1*,6*'}"
                          RowDefinitions="{OnIdiom Phone='Auto,Auto', Desktop='Auto'}"
                          RowSpacing="48">

                        <!-- .match__intro -->
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Start">
                            <Label Text="Подбор профессии" Style="{StaticResource EyebrowStyle}" Margin="0,0,0,16" />
                            <Label Text="Расскажите о себе своими словами" Style="{StaticResource PageTitleStyle}" />
                            <Label Text="Что нравится, что получается, где учились, как хотите работать. Пишите как другу — резюме не нужно."
                                   Style="{StaticResource LeadTextStyle}" Margin="0,16,0,0" />

                            <!-- .match__form -->
                            <VerticalStackLayout Margin="0,32,0,0" Spacing="8">
                                <Label Text="О себе" Style="{StaticResource FieldLabelStyle}" />
                                <Border Style="{StaticResource TextareaBorderStyle}">
                                    <Editor Text="{Binding AboutText}" MaxLength="1500" MinimumHeightRequest="220"
                                            AutoSize="TextChanges" FontSize="17" />
                                </Border>
                                <!-- .match__meta -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding CharCountText}" FontFamily="JetBrainsMonoRegular" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
                                    <Label Grid.Column="1" Text="Не сохраняется в СТАРТЕР" FontFamily="JetBrainsMonoRegular" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
                                </Grid>
                                <Label Text="Текст отправляется серверу и настроенному ИИ-провайдеру для подбора. СТАРТЕР не сохраняет его в базе. Результат — рекомендация, не гарантия трудоустройства." FontSize="11" LineHeight="1.5" TextColor="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}"
                                       HorizontalTextAlignment="Center" Margin="0,8,0,0" />

                                <!-- .examples: чипы -->
                                <FlexLayout BindableLayout.ItemsSource="{Binding Examples}" Wrap="Wrap" Margin="0,12,0,0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MatchExample">
                                            <Button Text="{Binding Label}"
                                                    Style="{StaticResource BtnGhostStyle}"
                                                    HeightRequest="32" MinimumHeightRequest="32"
                                                    CornerRadius="4" Padding="12,0" FontSize="14"
                                                    Margin="0,0,8,8"
                                                    Command="{Binding ApplyExampleCommand, Source={RelativeSource AncestorType={x:Type vm:MatchViewModel}}, x:DataType='vm:MatchViewModel'}"
                                                    CommandParameter="{Binding .}" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>

                                <!-- гость: подбор только после входа -->
                                <HorizontalStackLayout IsVisible="{Binding IsGuest}" Spacing="4" HorizontalOptions="Center">
                                    <Label Text="Войти в аккаунт" FontSize="11" TextDecorations="Underline" TextColor="{AppThemeBinding Light={StaticResource AccentInkLight}, Dark={StaticResource AccentInkDark}}">
                                        <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToAccountCommand}" /></Label.GestureRecognizers>
                                    </Label>
                                    <Label Text=", чтобы запустить подбор." FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
                                </HorizontalStackLayout>

                                <Label Text="{Binding ErrorMessage}" Style="{StaticResource FieldErrorStyle}" MinimumHeightRequest="20" />

                                <Button Text="{Binding SubmitText}"
                                        Style="{StaticResource BtnAccentStyle}"
                                        Command="{Binding SubmitMatchCommand}"
                                        IsEnabled="{Binding CanSubmit}"
                                        HorizontalOptions="Start" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- .match__result -->
                        <Grid Grid.Row="{OnIdiom Phone='1', Desktop='0'}"
                              Grid.Column="{OnIdiom Phone='0', Desktop='2'}"
                              MinimumHeightRequest="{OnIdiom Phone=0, Desktop=420}">

                            <!-- Пустое состояние с котом Стартером -->
                            <VerticalStackLayout IsVisible="{Binding ShowPlaceholder}" Spacing="22" Padding="0,48"
                                                 HorizontalOptions="Center" VerticalOptions="Center">
                                <Image Source="mascot_map.png" WidthRequest="{OnIdiom Phone=260, Desktop=360}" Aspect="AspectFit" HorizontalOptions="Center" />
                                <Label Text="Давай найдём то, что по душе" FontFamily="GolosTextMedium" FontSize="22"
                                       HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                            </VerticalStackLayout>

                            <!-- Загрузка рекомендаций -->
                            <VerticalStackLayout IsVisible="{Binding IsAnalyzing}" Spacing="12" Padding="0,48"
                                                 HorizontalOptions="Center" VerticalOptions="Center">
                                <Image Source="mascot_laptop.png" WidthRequest="220" Aspect="AspectFit" HorizontalOptions="Center" />
                                <ActivityIndicator IsRunning="{Binding IsAnalyzing}" WidthRequest="28" HeightRequest="28" />
                                <Label Text="ИИ анализирует рассказ и ищет вакансии в базе…" FontSize="16"
                                       HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                                <Label Text="Это может занять несколько секунд." FontSize="11"
                                       HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
                            </VerticalStackLayout>

                            <!-- Результаты API -->
                            <VerticalStackLayout IsVisible="{Binding HasResult}">
                                <!-- .insight -->
                                <Label Text="Ваши возможности" Style="{StaticResource EyebrowStyle}" Margin="0,0,0,12" />
                                <Label Text="Три направления для старта" FontFamily="GolosTextMedium" FontSize="22" TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                                <Label Text="Вакансии ниже — из реальной базы. Обратите внимание на требования работодателей."
                                       FontSize="11" LineHeight="1.5" TextColor="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" Margin="0,8,0,0" />

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Directions}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DirectionView">
                                            <!-- .direction -->
                                            <Grid>
                                                <Grid ColumnDefinitions="{OnIdiom Phone='28,*', Desktop='48,*'}" RowDefinitions="Auto,Auto" Padding="0,32">
                                                    <Label Text="{Binding Num}" FontFamily="JetBrainsMonoMedium" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource AccentInkLight}, Dark={StaticResource AccentInkDark}}" VerticalOptions="Center" />
                                                    <Label Grid.Column="1" Text="{Binding Name}" FontFamily="GolosTextMedium" FontSize="22" LineHeight="1.2" TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                                                    <VerticalStackLayout Grid.Row="1" Grid.Column="{OnIdiom Phone=0, Desktop=1}" Grid.ColumnSpan="{OnIdiom Phone=2, Desktop=1}">
                                                        <Label Text="{Binding What}" FontSize="16" LineHeight="1.55" TextColor="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}" Margin="0,8,0,0" />
                                                        <!-- .direction__why: акцентная полоса слева -->
                                                        <Grid ColumnDefinitions="2,*" ColumnSpacing="16" Margin="0,16,0,0">
                                                            <BoxView Color="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                                            <Label Grid.Column="1" Text="{Binding Why}" FontSize="16" LineHeight="1.55" TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                                                        </Grid>
                                                        <Label IsVisible="{Binding HasEvidence}" FontSize="11" LineHeight="1.5" TextColor="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" Margin="0,12,0,0">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="Основано на ваших словах: " />
                                                                    <Span Text="{Binding Evidence}" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>
                                                        <Label Text="Вакансии по направлению" FontFamily="GolosTextSemiBold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" Margin="0,24,0,8" />
                                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Jobs}" IsVisible="{Binding HasJobs}">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:VacancyItemViewModel">
                                                                    <controls:VacancyRow />
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </VerticalStackLayout>
                                                        <Label IsVisible="{Binding NoJobs}" Padding="16" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}"
                                                               Text="Сейчас в базе нет подходящих активных вакансий по этому направлению." />
                                                    </VerticalStackLayout>
                                                </Grid>
                                                <BoxView HeightRequest="1" VerticalOptions="End" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Grid>

                <controls:AppFooter />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
