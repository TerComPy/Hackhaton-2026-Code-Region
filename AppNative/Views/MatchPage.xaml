<?xml version="1.0" encoding="utf-8" ?>
<!-- Подбор профессии = Match.vue: слева рассказ о себе, справа три направления с вакансиями. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppNative.ViewModels"
             xmlns:controls="clr-namespace:AppNative.Views.Controls"
             x:Class="AppNative.Views.MatchPage"
             x:DataType="vm:MatchViewModel"
             Title="Подбор"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <controls:AppTopBar Grid.Row="0" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout>
                <Grid Padding="{OnIdiom Phone='16,40,16,96', Desktop='32,64,32,128'}">
                    <Grid MaximumWidthRequest="1320" HorizontalOptions="Fill"
                          ColumnDefinitions="{OnIdiom Phone='*', Desktop='5*,1*,6*'}"
                          RowDefinitions="{OnIdiom Phone='Auto,Auto', Desktop='Auto'}"
                          RowSpacing="48">

                        <!-- .match__intro -->
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Start">
                            <Label Text="Подбор профессии" Style="{StaticResource EyebrowStyle}" Margin="0,0,0,16" />
                            <Label Text="Расскажите о себе своими словами" Style="{StaticResource PageTitleStyle}" />
                            <Label Text="Что нравится, что получается, где учились, как хотите работать. Пишите как другу — резюме не нужно."
                                   Style="{StaticResource LeadTextStyle}" Margin="0,16,0,0" />

                            <!-- .match__form -->
                            <VerticalStackLayout Margin="0,32,0,0" Spacing="8">
                                <Label Text="О себе" Style="{StaticResource FieldLabelStyle}" />
                                <Border Style="{StaticResource TextareaBorderStyle}">
                                    <Editor Text="{Binding AboutText}" MaxLength="1500" MinimumHeightRequest="220"
                                            AutoSize="TextChanges" FontSize="17" />
                                </Border>
                                <!-- .match__meta -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding CharCountText}" FontFamily="JetBrainsMonoRegular" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
                                    <Label Grid.Column="1" Text="Хранится только на этом устройстве" FontFamily="JetBrainsMonoRegular" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
                                </Grid>
                                <Label Text="Демо-подбор по ключевым словам, без обращения к ИИ." FontSize="11" LineHeight="1.5" TextColor="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}"
                                       HorizontalTextAlignment="Center" Margin="0,8,0,0" />

                                <!-- .examples: чипы -->
                                <FlexLayout BindableLayout.ItemsSource="{Binding Examples}" Wrap="Wrap" Margin="0,12,0,0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MatchExample">
                                            <Button Text="{Binding Label}"
                                                    Style="{StaticResource BtnGhostStyle}"
                                                    HeightRequest="32" MinimumHeightRequest="32"
                                                    CornerRadius="4" Padding="12,0" FontSize="14"
                                                    Margin="0,0,8,8"
                                                    Command="{Binding ApplyExampleCommand, Source={RelativeSource AncestorType={x:Type vm:MatchViewModel}}, x:DataType='vm:MatchViewModel'}"
                                                    CommandParameter="{Binding .}" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>

                                <Label Text="{Binding ErrorMessage}" Style="{StaticResource FieldErrorStyle}" MinimumHeightRequest="20" />

                                <Button Text="Подобрать профессии"
                                        Style="{StaticResource BtnAccentStyle}"
                                        Command="{Binding SubmitMatchCommand}"
                                        HorizontalOptions="Start" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- .match__result -->
                        <VerticalStackLayout Grid.Row="{OnIdiom Phone='1', Desktop='0'}"
                                             Grid.Column="{OnIdiom Phone='0', Desktop='2'}"
                                             MinimumHeightRequest="420">
                            <Label Text="Здесь появятся три направления и подходящие вакансии."
                                   IsVisible="{Binding HasResult, Converter={StaticResource InverseBoolConverter}}"
                                   FontSize="16" TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Directions}" IsVisible="{Binding HasResult}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DirectionView">
                                        <!-- .direction: отступ 32, линия снизу -->
                                        <Grid>
                                            <VerticalStackLayout Padding="0,32" Spacing="8">
                                                <Label Text="{Binding Name}" FontFamily="GolosTextMedium" FontSize="22" LineHeight="1.2" TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                                                <Label Text="{Binding What}" FontSize="16" LineHeight="1.55" TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                                                <Label Text="{Binding Why}" FontSize="16" LineHeight="1.55" TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                                                <Label Text="{Binding Start}" FontSize="16" LineHeight="1.55" TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Jobs}" Margin="0,8,0,0">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:VacancyItemViewModel">
                                                            <controls:VacancyRow />
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                            <BoxView HeightRequest="1" VerticalOptions="End" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Grid>

                <controls:AppFooter />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
