<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AppNative.Models"
             x:Class="AppNative.Views.Controls.RingCardView"
             x:DataType="models:Vacancy">

    <Border StrokeThickness="0"
            StrokeShape="RoundRectangle 8"
            WidthRequest="196"
            HeightRequest="258"
            Margin="0,0,16,0"
            BackgroundColor="#2A2926">

        <Grid>
            <!-- Фотография профессии -->
            <Image Source="{Binding RingPhotoUrl}"
                   Aspect="AspectFill" />

            <!-- Градиентное затемнение снизу для читаемости текста -->
            <BoxView VerticalOptions="End"
                     HeightRequest="110">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0.0" />
                        <GradientStop Color="#CC000000" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <!-- Текст: профессия и зарплата -->
            <VerticalStackLayout VerticalOptions="End"
                                 Padding="14,12"
                                 Spacing="3">
                <Label Text="{Binding Short}"
                       TextColor="#FFFFFF"
                       FontFamily="GolosTextMedium"
                       FontSize="15" />
                <!-- .ring__pay: полная вилка, как salary(job) на сайте -->
                <Label Text="{Binding SalaryDisplay}"
                       TextColor="#C7FFFFFF"
                       FontFamily="JetBrainsMonoRegular"
                       FontSize="11" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
