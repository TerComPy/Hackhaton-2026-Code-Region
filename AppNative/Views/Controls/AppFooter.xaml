<?xml version="1.0" encoding="utf-8" ?>
<!-- Футер сайта (App.vue .footer): бренд, «Сервис», «Источники», «Контакты», ссылка на карту, нижняя строка. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppNative.ViewModels"
             x:Class="AppNative.Views.Controls.AppFooter"
             x:DataType="vm:AppShellViewModel">

    <ContentView.Resources>
        <Style x:Key="FooterHeadStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="JetBrainsMonoMedium" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CharacterSpacing" Value="1.2" />
            <Setter Property="TextTransform" Value="Uppercase" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
        </Style>
        <Style x:Key="FooterLinkStyle" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}" />
        </Style>
        <Style x:Key="FooterTextStyle" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="1.55" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
        </Style>
    </ContentView.Resources>

    <Grid x:Name="FooterRoot" Padding="{OnIdiom Phone='16,48,16,32', Desktop='32,48,32,32'}">
        <BoxView HeightRequest="1" VerticalOptions="Start" Margin="{OnIdiom Phone='-16,-48,-16,0', Desktop='-32,-48,-32,0'}"
                 Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />

        <VerticalStackLayout MaximumWidthRequest="1320" HorizontalOptions="Fill">
            <!-- .footer__top: 1.4fr 1fr 1fr 1.3fr -->
            <Grid ColumnDefinitions="{OnIdiom Phone='*', Desktop='1.4*,1*,1*,1.3*'}"
                  RowDefinitions="{OnIdiom Phone='Auto,Auto,Auto,Auto', Desktop='Auto'}"
                  ColumnSpacing="32" RowSpacing="32">

                <VerticalStackLayout Grid.Column="0" Spacing="12">
                    <Image Source="{AppThemeBinding Light=brand_wordmark_light.png, Dark=brand_wordmark_dark.png}" HeightRequest="32" Aspect="AspectFit" HorizontalOptions="Start"
                           SemanticProperties.Description="Стартер — на главную">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToCommand}" CommandParameter="home" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Label Style="{StaticResource FooterTextStyle}" MaximumWidthRequest="340" HorizontalOptions="Start"
                           Text="Вакансии с нескольких площадок в одном каталоге. Пересказываем объявления простыми словами и подсказываем, какая профессия подойдёт." />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="{OnIdiom Phone='1', Desktop='0'}" Grid.Column="{OnIdiom Phone='0', Desktop='1'}" Spacing="8">
                    <Label Text="Сервис" Style="{StaticResource FooterHeadStyle}" Margin="0,0,0,4" />
                    <Label Text="Вакансии" Style="{StaticResource FooterLinkStyle}">
                        <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToCommand}" CommandParameter="home" /></Label.GestureRecognizers>
                    </Label>
                    <Label Text="Подбор профессии" Style="{StaticResource FooterLinkStyle}">
                        <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToCommand}" CommandParameter="match" /></Label.GestureRecognizers>
                    </Label>
                    <Label Text="Избранное" Style="{StaticResource FooterLinkStyle}">
                        <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToCommand}" CommandParameter="saved" /></Label.GestureRecognizers>
                    </Label>
                    <Label Text="Профиль" Style="{StaticResource FooterLinkStyle}">
                        <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToCommand}" CommandParameter="account" /></Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="{OnIdiom Phone='2', Desktop='0'}" Grid.Column="{OnIdiom Phone='0', Desktop='2'}" Spacing="8">
                    <Label Text="Источники" Style="{StaticResource FooterHeadStyle}" Margin="0,0,0,4" />
                    <Label Text="Работа России" Style="{StaticResource FooterLinkStyle}">
                        <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenUrlCommand}" CommandParameter="https://trudvsem.ru" /></Label.GestureRecognizers>
                    </Label>
                    <Label Text="hh.ru" Style="{StaticResource FooterLinkStyle}">
                        <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenUrlCommand}" CommandParameter="https://hh.ru" /></Label.GestureRecognizers>
                    </Label>
                    <Label Text="SuperJob" Style="{StaticResource FooterLinkStyle}">
                        <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenUrlCommand}" CommandParameter="https://superjob.ru" /></Label.GestureRecognizers>
                    </Label>
                    <Label Text="Отклик отправляется на сайте источника." Style="{StaticResource FooterTextStyle}" Margin="0,4,0,0" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="{OnIdiom Phone='3', Desktop='0'}" Grid.Column="{OnIdiom Phone='0', Desktop='3'}" Spacing="8">
                    <Label Text="Контакты" Style="{StaticResource FooterHeadStyle}" Margin="0,0,0,4" />
                    <Label Text="hello@starter.example" Style="{StaticResource FooterLinkStyle}">
                        <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenUrlCommand}" CommandParameter="mailto:hello@starter.example" /></Label.GestureRecognizers>
                    </Label>
                    <Label Text="+7 (000) 000-00-00" Style="{StaticResource FooterLinkStyle}">
                        <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenUrlCommand}" CommandParameter="tel:+70000000000" /></Label.GestureRecognizers>
                    </Label>
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="Max" Style="{StaticResource FooterLinkStyle}">
                            <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenUrlCommand}" CommandParameter="https://max.ru/" /></Label.GestureRecognizers>
                        </Label>
                        <Label Text="·" Style="{StaticResource FooterLinkStyle}" />
                        <Label Text="VK" Style="{StaticResource FooterLinkStyle}">
                            <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenUrlCommand}" CommandParameter="https://vk.com/" /></Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>

            <!-- .footer__map: вместо встроенной карты — ссылка -->
            <HorizontalStackLayout Spacing="4" Margin="0,32,0,0">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenUrlCommand}"
                                          CommandParameter="https://yandex.ru/maps/?ll=37.8028%2C48.0159&amp;pt=37.8028%2C48.0159&amp;z=15" />
                </HorizontalStackLayout.GestureRecognizers>
                <Label Text="Открыть в Яндекс Картах" FontFamily="GolosTextMedium" FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource AccentInkLight}, Dark={StaticResource AccentInkDark}}" />
                <Label Text="↗" FontFamily="GolosTextMedium" FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource AccentInkLight}, Dark={StaticResource AccentInkDark}}" />
            </HorizontalStackLayout>

            <!-- .footer__bottom -->
            <BoxView HeightRequest="1" Margin="0,32,0,24"
                     Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
            <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween">
                <Label Text="© 2026 Стартер · хакатон «Код региона — 2026»" FontSize="12" Margin="0,0,24,8"
                       TextColor="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
                <Label FontSize="12" MaximumWidthRequest="520" Margin="0,0,24,8"
                       TextColor="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}"
                       Text="Прототип: вакансии демонстрационные, компании вымышлены. Сервис не принимает и не пересылает отклики. Фотографии — Unsplash." />
                <Label Text="Политика конфиденциальности · Пользовательское соглашение" FontSize="12" Margin="0,0,0,8"
                       TextColor="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}" />
            </FlexLayout>
        </VerticalStackLayout>
        <!-- .footer__cat: кот с клубком, только на главной (ShowCat) -->
        <Image x:Name="FooterCat" Source="mascot_footer_ball.png" IsVisible="False"
               HeightRequest="{OnIdiom Phone=100, Desktop=150}" Aspect="AspectFit"
               HorizontalOptions="End" VerticalOptions="End" InputTransparent="True" />
    </Grid>
</ContentView>
