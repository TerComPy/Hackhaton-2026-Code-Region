<?xml version="1.0" encoding="utf-8" ?>
<!-- Карточка вакансии = VacancySheet.vue: панель справа (600px) поверх затемнённой страницы,
     на телефоне — во весь экран. Тексты и порядок блоков как на сайте. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppNative.ViewModels"
             x:Class="AppNative.Views.VacancyPage"
             x:DataType="vm:VacancyViewModel"
             Shell.PresentationMode="ModalAnimated"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{OnIdiom Phone='#00000000', Desktop='#800C0C0B'}"
             Title="Вакансия">

    <ContentPage.Resources>
        <Style x:Key="FactLabelStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="JetBrainsMonoMedium" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="1" />
            <Setter Property="TextTransform" Value="Uppercase" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
        </Style>
        <Style x:Key="FlipHeadStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="GolosTextSemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        </Style>
        <Style x:Key="FlipTextStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="GolosTextRegular" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="LineHeight" Value="1.4" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}" />
        </Style>
        <!-- .seg__btn: прозрачная, ink-2; активная «Простыми словами» — акцент, «Как у работодателя» — ink на bg -->
        <Style x:Key="SegButtonStyle" TargetType="Button">
            <Setter Property="HeightRequest" Value="36" />
            <Setter Property="MinimumHeightRequest" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="FontFamily" Value="GolosTextMedium" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}" />
        </Style>
    </ContentPage.Resources>

    <!-- Затемнение слева от панели (на WinUI тапы всплывают к родителю, поэтому закрытие — только кнопкой ✕) -->
    <Grid>

        <Grid RowDefinitions="Auto,*,Auto"
              WidthRequest="{OnIdiom Phone='-1', Desktop='600'}"
              HorizontalOptions="{OnIdiom Phone='Fill', Desktop='End'}"
              BackgroundColor="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}">

            <!-- .sheet__bar -->
            <Grid Grid.Row="0">
                <Grid ColumnDefinitions="*,Auto" Padding="24,12">
                    <Label Text="{Binding Vacancy.Source}"
                           FontFamily="JetBrainsMonoMedium" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            ImageSource="{AppThemeBinding Light=i_close.png, Dark=i_close_d.png}"
                            Command="{Binding CloseCommand}"
                            WidthRequest="40" HeightRequest="40" MinimumHeightRequest="40"
                            CornerRadius="8" Padding="0" BorderWidth="1"
                            BackgroundColor="Transparent"
                            BorderColor="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}"
                            SemanticProperties.Description="Закрыть" />
                </Grid>
                <BoxView HeightRequest="1" VerticalOptions="End" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout>
                    <!-- .sheet__media 16:8 -->
                    <Image Source="{Binding Vacancy.LargePhotoUrl}"
                           Aspect="AspectFill"
                           HeightRequest="{OnIdiom Phone='200', Desktop='300'}"
                           BackgroundColor="{AppThemeBinding Light={StaticResource BgRaiseLight}, Dark={StaticResource BgRaiseDark}}" />

                    <!-- .sheet__body -->
                    <VerticalStackLayout Padding="24,32,24,48">
                        <Label Text="{Binding Vacancy.Title}"
                               FontFamily="GolosTextMedium" FontSize="28" LineHeight="1.15"
                               TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                        <Label Margin="0,8,0,0" FontFamily="GolosTextRegular" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Vacancy.Company}" />
                                    <Span Text=" · " />
                                    <Span Text="{Binding Vacancy.City}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- .facts: Зарплата / Формат / Опыт -->
                        <Grid Margin="0,24,0,0" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                            <BoxView Grid.ColumnSpan="2" HeightRequest="1" VerticalOptions="Start" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                            <Grid Grid.Row="0" Grid.Column="0">
                                <VerticalStackLayout Padding="0,12,16,12" Spacing="2">
                                    <Label Text="Зарплата" Style="{StaticResource FactLabelStyle}" />
                                    <Label Text="{Binding Vacancy.SalaryDisplay}" FontFamily="GolosTextMedium" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                                </VerticalStackLayout>
                                <BoxView HeightRequest="1" VerticalOptions="End" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                            </Grid>
                            <Grid Grid.Row="0" Grid.Column="1">
                                <VerticalStackLayout Padding="0,12" Spacing="2">
                                    <Label Text="Формат" Style="{StaticResource FactLabelStyle}" />
                                    <Label Text="{Binding Vacancy.Format}" FontFamily="GolosTextMedium" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                                </VerticalStackLayout>
                                <BoxView HeightRequest="1" VerticalOptions="End" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="0">
                                <VerticalStackLayout Padding="0,12,16,12" Spacing="2">
                                    <Label Text="Опыт" Style="{StaticResource FactLabelStyle}" />
                                    <Label Text="{Binding Vacancy.Experience}" FontFamily="GolosTextMedium" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                                </VerticalStackLayout>
                                <BoxView HeightRequest="1" VerticalOptions="End" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                            </Grid>
                        </Grid>

                        <!-- .seg -->
                        <Border Margin="0,32,0,0"
                                Padding="3"
                                HorizontalOptions="Start"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource LineStrongLight}, Dark={StaticResource LineStrongDark}}">
                            <HorizontalStackLayout>
                                <Button Text="Простыми словами"
                                        Style="{StaticResource SegButtonStyle}"
                                        Command="{Binding SetModeCommand}"
                                        CommandParameter="plain">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsPlainMode}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Text="Как у работодателя"
                                        Style="{StaticResource SegButtonStyle}"
                                        Command="{Binding SetModeCommand}"
                                        CommandParameter="original">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsPlainMode}" Value="False">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- .flip__plain -->
                        <Border Margin="0,24,0,0" Padding="24"
                                IsVisible="{Binding IsPlainMode}"
                                StrokeThickness="1" StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                            <VerticalStackLayout>
                                <Label Text="Что делать" Style="{StaticResource FlipHeadStyle}" Margin="0,0,0,0" />
                                <Label Text="{Binding Vacancy.Plain.Duties}" Style="{StaticResource FlipTextStyle}" />
                                <Label Text="Что нужно" Style="{StaticResource FlipHeadStyle}" Margin="0,16,0,0" />
                                <Label Text="{Binding Vacancy.Plain.Requirements}" Style="{StaticResource FlipTextStyle}" />
                                <Label Text="Условия" Style="{StaticResource FlipHeadStyle}" Margin="0,16,0,0" />
                                <Label Text="{Binding Vacancy.Plain.Conditions}" Style="{StaticResource FlipTextStyle}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- .flip__original -->
                        <Border Margin="0,24,0,0" Padding="24"
                                IsVisible="{Binding IsPlainMode, Converter={StaticResource InverseBoolConverter}}"
                                StrokeThickness="1" StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                            <VerticalStackLayout>
                                <Label Text="Что делать" Style="{StaticResource FlipHeadStyle}" Margin="0,0,0,0" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Vacancy.Original.Duties}" Spacing="2">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid ColumnDefinitions="16,*">
                                                <BoxView WidthRequest="5" HeightRequest="1" HorizontalOptions="Start" VerticalOptions="Start" Margin="2,15,0,0" Color="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}" />
                                                <Label Grid.Column="1" Text="{Binding .}" Style="{StaticResource FlipTextStyle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <Label Text="Что нужно" Style="{StaticResource FlipHeadStyle}" Margin="0,16,0,0" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Vacancy.Original.Requirements}" Spacing="2">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid ColumnDefinitions="16,*">
                                                <BoxView WidthRequest="5" HeightRequest="1" HorizontalOptions="Start" VerticalOptions="Start" Margin="2,15,0,0" Color="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}" />
                                                <Label Grid.Column="1" Text="{Binding .}" Style="{StaticResource FlipTextStyle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <Label Text="Условия" Style="{StaticResource FlipHeadStyle}" Margin="0,16,0,0" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Vacancy.Original.Conditions}" Spacing="2">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid ColumnDefinitions="16,*">
                                                <BoxView WidthRequest="5" HeightRequest="1" HorizontalOptions="Start" VerticalOptions="Start" Margin="2,15,0,0" Color="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}" />
                                                <Label Grid.Column="1" Text="{Binding .}" Style="{StaticResource FlipTextStyle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <!-- .sheet__foot -->
            <Grid Grid.Row="2" BackgroundColor="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}">
                <Grid Padding="24,16" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <Button Grid.Column="0"
                            Text="{Binding Vacancy.Source, StringFormat='Открыть на {0}'}"
                            Style="{StaticResource BtnAccentStyle}"
                            Command="{Binding OpenExternalCommand}" />
                    <Button Grid.Column="1"
                            Command="{Binding ToggleFavoriteCommand}"
                            WidthRequest="48" HeightRequest="48" MinimumHeightRequest="48"
                            CornerRadius="8" BorderWidth="1" Padding="0"
                        BackgroundColor="Transparent"
                            SemanticProperties.Description="Сохранить в избранное">
                        <!-- .save[aria-pressed=true]: закладка залита, рамка акцентная -->
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsFavorite}" Value="False">
                                <Setter Property="ImageSource" Value="{AppThemeBinding Light=i_bookmark.png, Dark=i_bookmark_d.png}" />
                                <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsFavorite}" Value="True">
                                <Setter Property="ImageSource" Value="i_bookmark_f.png" />
                                <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource AccentInkLight}, Dark={StaticResource AccentInkDark}}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Label Grid.Row="1" Grid.ColumnSpan="2"
                           Text="Демо-вакансия: ссылка открывает поиск похожих объявлений."
                           FontFamily="GolosTextRegular" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
                </Grid>
                <BoxView HeightRequest="1" VerticalOptions="Start" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
