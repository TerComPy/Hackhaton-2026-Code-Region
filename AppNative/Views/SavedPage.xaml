<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppNative.ViewModels"
             xmlns:controls="clr-namespace:AppNative.Views.Controls"
             x:Class="AppNative.Views.SavedPage"
             x:DataType="vm:SavedViewModel"
             Title="Избранное"
             Shell.NavBarIsVisible="False">

    <!-- Избранное = Saved.vue: заголовок + «N сохранено», список с линией ink сверху, пустое состояние .state -->
    <Grid RowDefinitions="Auto,*">
        <controls:AppTopBar Grid.Row="0" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout>
                <Grid Padding="{OnIdiom Phone='16,40,16,96', Desktop='32,64,32,128'}">
                    <VerticalStackLayout MaximumWidthRequest="1320" HorizontalOptions="Fill">
                        <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="End" Margin="0,0,0,32">
                            <Label Text="Избранное" Style="{StaticResource PageTitleStyle}" Margin="0,0,24,0" />
                            <Label Text="{Binding CountText}" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                        </FlexLayout>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding SavedVacancies}"
                                             BindableLayout.ItemTemplate="{StaticResource VacancyDataTemplate}" />

                        <!-- .state -->
                        <VerticalStackLayout IsVisible="{Binding IsEmpty}" Padding="0,64" MaximumWidthRequest="460" HorizontalOptions="Start">
                            <!-- маскот Стартера машет: пока пусто -->
                            <Image Source="mascot_wave.png" WidthRequest="200" Aspect="AspectFit" HorizontalOptions="Start" Margin="0,0,0,16" />
                            <Label Text="Здесь будут сохранённые вакансии" FontFamily="GolosTextMedium" FontSize="22" TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                            <Label Text="Нажмите на закладку рядом с вакансией." FontSize="16" TextColor="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}" Margin="0,8,0,0" />
                            <Button Text="Перейти в каталог"
                                    Style="{StaticResource BtnGhostStyle}"
                                    Command="{Binding NavigateToCatalogCommand}"
                                    HorizontalOptions="Start"
                                    Margin="0,24,0,0" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Grid>

                <controls:AppFooter />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
