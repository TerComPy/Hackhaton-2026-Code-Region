<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- =========================================================================
         Стартер — Стили приложения
         Строго по DESIGN.md и styles.css
         ========================================================================= -->

    <!-- Шкала отступов (шаг 4px: s1..s10) -->
    <x:Double x:Key="Spacing1">4</x:Double>
    <x:Double x:Key="Spacing2">8</x:Double>
    <x:Double x:Key="Spacing3">12</x:Double>
    <x:Double x:Key="Spacing4">16</x:Double>
    <x:Double x:Key="Spacing5">24</x:Double>
    <x:Double x:Key="Spacing6">32</x:Double>
    <x:Double x:Key="Spacing7">48</x:Double>
    <x:Double x:Key="Spacing8">64</x:Double>
    <x:Double x:Key="Spacing9">96</x:Double>
    <x:Double x:Key="Spacing10">128</x:Double>

    <!-- Скругления (r-sm, r-md) -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusMedia">6</CornerRadius>
    <CornerRadius x:Key="RadiusSheet">12,12,0,0</CornerRadius>

    <!-- Имена зарегистрированных шрифтов -->
    <x:String x:Key="FontRegular">GolosTextRegular</x:String>
    <x:String x:Key="FontMedium">GolosTextMedium</x:String>
    <x:String x:Key="FontSemiBold">GolosTextSemiBold</x:String>
    <x:String x:Key="FontMono">JetBrainsMonoRegular</x:String>
    <x:String x:Key="FontMonoMedium">JetBrainsMonoMedium</x:String>

    <!-- ==================== НЕЯВНЫЕ СТИЛИ (IMPLICIT) ==================== -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}" />
    </Style>

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="FontFamily" Value="GolosTextRegular"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="LineHeight" Value="1.4"/>
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="GolosTextMedium"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="BorderWidth" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BgRaiseLight}, Dark={StaticResource BgRaiseDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource LineStrongLight}, Dark={StaticResource LineStrongDark}}" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="GolosTextRegular"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
    </Style>

    <Style TargetType="Editor">
        <Setter Property="FontFamily" Value="GolosTextRegular"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="MinimumHeightRequest" Value="140"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="MinimumHeightRequest" Value="32"/>
        <Setter Property="MinimumWidthRequest" Value="32"/>
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
    </Style>

    <!-- Shell стили -->
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="Shell.DisabledColor" Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
        <Setter Property="Shell.UnselectedColor" Value="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
    </Style>

    <!-- ==================== ЯВНЫЕ СТИЛИ (EXPLICIT) ==================== -->

    <!-- Типографика -->
    <Style x:Key="HeroTitleStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="GolosTextMedium"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"/>
        <Setter Property="LineHeight" Value="1.02"/>
        <Setter Property="CharacterSpacing" Value="-1.5"/>
        <Setter Property="FontSize">
            <OnIdiom x:TypeArguments="x:Double" Phone="40" Desktop="64"/>
        </Setter>
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="GolosTextMedium"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"/>
        <Setter Property="LineHeight" Value="1.1"/>
        <Setter Property="CharacterSpacing" Value="-0.5"/>
        <Setter Property="FontSize">
            <OnIdiom x:TypeArguments="x:Double" Phone="30" Desktop="40"/>
        </Setter>
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="GolosTextMedium"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"/>
        <Setter Property="LineHeight" Value="1.15"/>
        <Setter Property="FontSize">
            <OnIdiom x:TypeArguments="x:Double" Phone="22" Desktop="28"/>
        </Setter>
    </Style>

    <Style x:Key="SubTitleStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="GolosTextMedium"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="LineHeight" Value="1.25"/>
    </Style>

    <Style x:Key="LeadTextStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="GolosTextRegular"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}"/>
        <Setter Property="FontSize">
            <OnIdiom x:TypeArguments="x:Double" Phone="16" Desktop="18"/>
        </Setter>
        <Setter Property="LineHeight" Value="1.55"/>
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="GolosTextRegular"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="LineHeight" Value="1.55"/>
    </Style>

    <Style x:Key="JobTitleStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="GolosTextMedium"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"/>
        <Setter Property="LineHeight" Value="1.3"/>
        <Setter Property="FontSize">
            <OnIdiom x:TypeArguments="x:Double" Phone="17" Desktop="19"/>
        </Setter>
    </Style>

    <Style x:Key="EyebrowStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="JetBrainsMonoMedium"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CharacterSpacing" Value="1"/>
        <Setter Property="TextTransform" Value="Uppercase"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}"/>
    </Style>

    <Style x:Key="MonoMetaStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="JetBrainsMonoRegular"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}"/>
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="GolosTextMedium"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"/>
    </Style>

    <Style x:Key="FieldHintStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="GolosTextRegular"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}"/>
    </Style>

    <Style x:Key="FieldErrorStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="GolosTextRegular"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentInkLight}, Dark={StaticResource AccentInkDark}}"/>
    </Style>

    <!-- Кнопки -->
    <Style x:Key="BtnAccentStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="GolosTextMedium"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="HeightRequest" Value="48"/>
        <Setter Property="MinimumHeightRequest" Value="48"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}"/>
    </Style>

    <Style x:Key="BtnGhostStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="GolosTextMedium"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="HeightRequest" Value="48"/>
        <Setter Property="MinimumHeightRequest" Value="48"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderWidth" Value="1"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"/>
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource LineStrongLight}, Dark={StaticResource LineStrongDark}}"/>
    </Style>

    <Style x:Key="BtnIconStyle" TargetType="Button">
        <Setter Property="WidthRequest" Value="40"/>
        <Setter Property="HeightRequest" Value="40"/>
        <Setter Property="MinimumWidthRequest" Value="40"/>
        <Setter Property="MinimumHeightRequest" Value="40"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderWidth" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"/>
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}"/>
    </Style>

    <Style x:Key="ChipStyle" TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LineStrongLight}, Dark={StaticResource LineStrongDark}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 4"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="Padding" Value="12,6"/>
    </Style>

    <Style x:Key="TagStyle" TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LineStrongLight}, Dark={StaticResource LineStrongDark}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 4"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="HeightRequest" Value="24"/>
    </Style>

    <Style x:Key="TagFitStyle" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 4"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="HeightRequest" Value="24"/>
    </Style>

    <Style x:Key="TagLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="GolosTextRegular"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>

    <Style x:Key="TagFitLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="GolosTextMedium"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>

    <!-- Инпуты с рамкой -->
    <Style x:Key="InputBorderStyle" TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LineStrongLight}, Dark={StaticResource LineStrongDark}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="HeightRequest" Value="44"/>
    </Style>

    <Style x:Key="InputLargeBorderStyle" TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LineStrongLight}, Dark={StaticResource LineStrongDark}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="HeightRequest" Value="48"/>
    </Style>

    <Style x:Key="TextareaBorderStyle" TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LineStrongLight}, Dark={StaticResource LineStrongDark}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

</ResourceDictionary>
