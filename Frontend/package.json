{
  "name": "starter-vue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build",
    "test:smoke": "playwright test",
    "test:api-mode": "playwright test --config playwright.api.config.ts",
    "test:http": "playwright test tests/api.spec.ts tests/http-foundation.spec.ts --project=desktop",
    "test:ai-ui": "playwright test --config playwright.ai.config.ts",
    "test:match-ui": "playwright test --config playwright.match.config.ts"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "pinia": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "vue-tsc": "^3.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0"
  }
}
